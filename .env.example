# Host port for the loopback-only Web publication.
FEEDER_PORT=8080

# Explicitly trusted HTTP Host authorities. Include the chosen host port when
# accessing through localhost. Compose computes defaults from FEEDER_PORT.
# Keep 127.0.0.1:8080 for the health probe when overriding the list.
# FEEDER_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080,web:8080

# Demo articles are disabled unless explicitly enabled for a disposable setup.
FEEDER_DEMO=0
