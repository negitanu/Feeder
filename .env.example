# Web を localhost 内だけで公開するポート番号です。
FEEDER_PORT=8080

# HTTP Host として信頼する接続先を明示します。localhost 経由で使う場合は
# ポート番号も含めてください。既定値は FEEDER_PORT から Compose が設定します。
# この一覧を変更する場合も、health check 用に 127.0.0.1:8080 を残してください。
# FEEDER_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080,web:8080

# デモ記事は通常無効です。使い捨ての検証環境で明示的に有効化できます。
FEEDER_DEMO=0

# 将来の AI 連携用の任意の認証キーです。Web と worker に渡されますが、
# AI プロバイダー機能は未実装のため、設定しても AI 機能は有効になりません。
OPENROUTER_API_KEY=
ORCAROUTER_API_KEY=

# Cloudflare Tunnel の値を設定し、docker compose up -d で起動します。
# Tunnel 利用時はFEEDER_ACCESS_MODEをtunnelにし、Webはlocalhostにのみ公開されます。
# Cloudflare 側の公開ホストの転送先は http://web:8080 に設定してください。
# 先に対象ホストのCloudflare AccessポリシーとProtect with Accessを設定してください。
# FEEDER_PUBLIC_ORIGIN=https://feeder.example.com
# FEEDER_PUBLIC_HOST=feeder.example.com
# FEEDER_ALLOWED_HOSTS=feeder.example.com,127.0.0.1:8080
# FEEDER_TUNNEL_IMAGE=cloudflare/cloudflared:2026.10.7
# FEEDER_ACCESS_MODE=tunnel
# TUNNEL_TOKEN=
# 実際の値は Git 管理対象外の .env にだけ記入してください。
