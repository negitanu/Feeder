# Host port for the loopback-only Web publication.
FEEDER_PORT=8080

# Explicitly trusted HTTP Host authorities. Include the chosen host port when
# accessing through localhost. Compose computes defaults from FEEDER_PORT.
# Keep 127.0.0.1:8080 for the health probe when overriding the list.
# FEEDER_ALLOWED_HOSTS=localhost:8080,127.0.0.1:8080,web:8080

# Demo articles are disabled unless explicitly enabled for a disposable setup.
FEEDER_DEMO=0

# Optional published deployment uses compose.tunnel.yml with no Web host port.
# First configure Cloudflare Access policy and Protect with Access for the host.
# FEEDER_PUBLIC_ORIGIN=https://feeder.example.com
# FEEDER_PUBLIC_HOST=feeder.example.com
# FEEDER_TUNNEL_IMAGE=cloudflare/cloudflared:2026.10.7
# FEEDER_TUNNEL_TOKEN_FILE=./secrets/tunnel-token
# Keep the token file outside Git; never put its contents in this example.
